#!/bin/bash
# speak: say a line with each word flashed on the stage, timed by the calibrated voice model.
# After every line a silent background render measures the true length and recalibrates.
D="$(cd "$(dirname "$0")" && pwd)"; TXT="$*"
. "$D/stage.sh"
EST=$(perl "$D/voice.pl" est "$TXT")
T=$(perl -MTime::HiRes=time -e 'printf "%.0f", time*1000+350')
ENC=$(printf '%s' "$TXT" | perl -pe 's/([^A-Za-z0-9_.~,;:!?\-])/sprintf("%%%02X",ord($1))/ge')
WID=$(stage_id)
if [ -n "$WID" ]; then   # stage off or gone: voice only
  osascript -e "tell application \"Safari\" to set URL of current tab of window id $WID to \"file://$D/stage.html#t=$T&d=$EST&w=$ENC\"" >/dev/null
  perl -MTime::HiRes=time,sleep -e "\$d=$T/1000-time; sleep(\$d) if \$d>0"
fi
[ -z "$PD_QUIET" ] && ( say -v Daniel -r 185 "$TXT" >/dev/null 2>&1 & )
( say -v Daniel -r 185 -o /tmp/pd-cal.aiff "$TXT" && A=$(afinfo /tmp/pd-cal.aiff | awk '/estimated duration/{print $3}') \
  && L=$(perl "$D/voice.pl" cal "$TXT" "$A") && echo "$(date '+%F %T') $L" >> "$D/runs.jsonl" ) >/dev/null 2>&1 &
echo "estimated ${EST}s"
"$D/tidy" >/dev/null 2>&1 &
